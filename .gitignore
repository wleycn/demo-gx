# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Virtual environment
.venv/

# Environment storage: the layering skeleton is committed so a fresh clone
# runs and reads out of the box; run artefacts are rebuildable and untracked.
data/*/output/*
!data/*/output/*/
data/*/output/*/*
!data/*/output/*/.gitkeep
# prod receives its inputs from the upstream system: placeholders only, no
# sample file. Local demo runs of ENV=prod may generate one; it stays ignored.
data/prod/input/*
!data/prod/input/.gitkeep

# System and editor
.DS_Store
.idea/
.vscode/
