#!/bin/sh
# Commit-msg gate (thin shell). Install into .git/hooks/commit-msg.
# Real script: ng/tools/pre_commit_gate.py --commit-msg (override with PRE_COMMIT_GATE).
#
# Install (once per clone):
#   mkdir -p .git/hooks && cp scripts/hooks/commit-msg .git/hooks/commit-msg \
#     && chmod +x .git/hooks/commit-msg
#
# What it checks: an agent-session commit (its environment carries HERMES_AGENT)
# must carry the provenance marker [AI] in the message. AGENTS.md section 5.
# A human commit carries no marker and is not asked for one.
set -e

GATE="${PRE_COMMIT_GATE:-$HOME/workspace/ng/tools/pre_commit_gate.py}"
ROOT="$(git rev-parse --show-toplevel)"

if [ ! -f "$GATE" ]; then
  echo "[gate] gate script not found: $GATE (skipping; set PRE_COMMIT_GATE or install ng/tools)" >&2
  exit 0
fi

exec python3 "$GATE" --repo "$ROOT" --commit-msg "$1"
